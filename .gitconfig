[core]
  excludesfile = ~/.gitignore
  autoCRLF = false
  editor = code --wait
  quotepath = false
[push]
  default = simple
[pull]
  rebase = merges
[merge]
  ff = false
[alias]
  ad = add
  br = branch
  cm = commit
  co = checkout
  cp = cherry-pick
  l = log --oneline
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  lga = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  sh = "!f() { d=$(mktemp -d) || return; git show \"$@\" > \"$d/show.patch\" && code --wait \"$d/show.patch\"; status=$?; rm -f -- \"$d/show.patch\"; rmdir -- \"$d\"; return \"$status\"; }; f"
  di = "!f() { d=$(mktemp -d) || return; git diff \"$@\" > \"$d/diff.patch\" && code --wait \"$d/diff.patch\"; status=$?; rm -f -- \"$d/diff.patch\"; rmdir -- \"$d\"; return \"$status\"; }; f"
[include]
  path = ~/.gitconfig.local
