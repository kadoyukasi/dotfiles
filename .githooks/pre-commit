#!/bin/bash

set -euo pipefail

TMPDIR_CHECK="$(mktemp -d)"
trap 'rm -f "$TMPDIR_CHECK/index" "$TMPDIR_CHECK/blob" "$TMPDIR_CHECK/filtered"; rmdir "$TMPDIR_CHECK"' EXIT

# Keep paths NUL-delimited and read blobs by object ID from the staged diff.
git diff --cached --raw -z --no-abbrev --no-renames --no-ext-diff --diff-filter=AMT -- > "$TMPDIR_CHECK/index"
if [ ! -s "$TMPDIR_CHECK/index" ]; then
    echo "[secret-check] skipped: no staged files"
    exit 0
fi

echo "[secret-check] scanning staged files..."

SENSITIVE_PATH_PATTERNS=(
    '(^|/)auth\.json$'
    '(^|/)\.config/gh/hosts\.yml$'
    '(^|/)\.codex/config\.local\.toml$'
    '(^|/)\.gitconfig\.local$'
    '(^|/)\.ssh/config\.local$'
    '(^|/)\.env(\.|$)'
    '(^|/)id_(rsa|dsa|ecdsa|ed25519)$'
    '\.pem$'
    '\.key$'
    '\.p12$'
    '\.pfx$'
    '\.sqlite([-.].*)?$'
    '\.db([-.].*)?$'
)

SENSITIVE_CONTENT_PATTERNS=(
    '-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----'
    '(AKIA|ASIA)[0-9A-Z]{16}'
    'gh[oprsu]_[A-Za-z0-9]{36,}'
    'github_pat_[A-Za-z0-9_]{82,}'
    'xox[baprs]-[A-Za-z0-9-]{10,}'
    'AIza[0-9A-Za-z_-]{35}'
    '(sk|rk)_live_[0-9A-Za-z]{20,}'
    'sk-(proj-[A-Za-z0-9_-]{32,}|[A-Za-z0-9]{48})'
    '(api[_-]?key|access[_-]?token|oauth[_-]?token|secret|password)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_./+=-]{12,}'
)

SENSITIVE_CONTENT_PATTERN=$(printf '%s|' "${SENSITIVE_CONTENT_PATTERNS[@]}")
SENSITIVE_CONTENT_PATTERN="${SENSITIVE_CONTENT_PATTERN%|}"

MACHINE_LOCAL_PATH_PATTERNS=(
    "/Users/[A-Za-z0-9._-]+/"
    "/home/[A-Za-z0-9._-]+/"
    "[A-Za-z]:[\\\\/]Users[\\\\/][A-Za-z0-9._-]+[\\\\/]"
)
MACHINE_LOCAL_PATH_PATTERN=$(printf '%s|' "${MACHINE_LOCAL_PATH_PATTERNS[@]}")
MACHINE_LOCAL_PATH_PATTERN="${MACHINE_LOCAL_PATH_PATTERN%|}"

IGNORE_LINE_MARKER='secret-check-ignore-line'
IGNORE_NEXT_LINE_MARKER='secret-check-ignore-next-line'
IGNORE_FILE_NAMES=(
    '.secret-check-ignore'
    '.git-secret-check-ignore'
)
IGNORE_FILE_PATHS=("")

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$repo_root" ]; then
    for ignore_filename in "${IGNORE_FILE_NAMES[@]}"; do
        ignore_path="$repo_root/$ignore_filename"
        if [ -f "$ignore_path" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                line="${line%%#*}"
                line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
                [ -n "$line" ] && IGNORE_FILE_PATHS+=("$line")
            done < "$ignore_path"
        fi
    done
fi

violations=0

while IFS= read -r -d '' header && IFS= read -r -d '' path; do
    read -r old_mode new_mode old_oid new_oid change <<< "$header"
    [ "$new_mode" = 160000 ] && continue

    # Skip files matched by ignore file patterns.
    for ignore_pattern in "${IGNORE_FILE_PATHS[@]}"; do
        case "$path" in
            $ignore_pattern)
                printf '[secret-check] ignored by ignore file: %q\n' "$path"
                continue 2
                ;;
        esac
    done

    for pattern in "${SENSITIVE_PATH_PATTERNS[@]}"; do
        if [[ "$path" =~ $pattern ]]; then
            printf '[secret-check] blocked by filename/path pattern: %q\n' "$path"
            violations=1
            break
        fi
    done

    git cat-file blob "$new_oid" > "$TMPDIR_CHECK/blob"
    if [ "$path" = ".codex/config.toml" ] &&
        grep -a -E '^[[:space:]]*\[(projects\.|hooks\.state(\]|\.)|marketplaces\.)' "$TMPDIR_CHECK/blob" >/dev/null; then
        printf '[secret-check] blocked machine-local Codex state in: %q\n' "$path"
        echo "Run the platform installer to enable the clean filter."
        violations=1
        continue
    fi

    ignore_next=0
    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$ignore_next" -eq 1 ]; then
            ignore_next=0
            continue
        fi

        case "$line" in
            *"$IGNORE_NEXT_LINE_MARKER"*)
                ignore_next=1
                continue
                ;;
            *"$IGNORE_LINE_MARKER"*)
                continue
                ;;
        esac

        printf '%s\n' "$line"
    done < "$TMPDIR_CHECK/blob" > "$TMPDIR_CHECK/filtered"

    if grep -a -E -i -- "$MACHINE_LOCAL_PATH_PATTERN" "$TMPDIR_CHECK/filtered" >/dev/null; then
        printf '[secret-check] blocked machine-local home path in: %q\n' "$path"
        violations=1
    elif [ "$?" -ne 1 ]; then
        echo "[secret-check] failed to scan staged paths." >&2
        exit 1
    fi

    if grep -a -E -i -- "$SENSITIVE_CONTENT_PATTERN" "$TMPDIR_CHECK/filtered" >/dev/null; then
        printf '[secret-check] blocked by content pattern in: %q\n' "$path"
        violations=1
    elif [ "$?" -ne 1 ]; then
        echo "[secret-check] failed to scan staged content." >&2
        exit 1
    fi
done < "$TMPDIR_CHECK/index"

if [ "$violations" -ne 0 ]; then
    echo ""
    echo "[secret-check] result: BLOCKED"
    echo "Commit blocked: potential sensitive data detected in staged changes."
    echo "Fix the files or unstage them, then commit again."
    exit 1
fi

echo "[secret-check] result: PASS"

exit 0
